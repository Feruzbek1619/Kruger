---
import '@/styles/global.css'
import '@/styles/skeleton.css'
import { ClientRouter } from 'astro:transitions'
import TopBar from '@/components/layouts/TopBar.astro'
import Header from '@/components/layouts/Header.astro'
import Footer from '@/components/layouts/Footer.astro'
import ContactStrip from '@/components/sections/ContactStrip.astro'
import FloatingButtons from '@/components/ui/FloatingButtons.vue'
import Toast from '@/components/ui/Toast.vue'
import { t } from '@/lib/i18n'
import { safeJsonLd } from '@/lib/jsonld'

interface Props {
  title?: string
  description?: string
  hideContactStrip?: boolean
  /** URL картинки, которая является LCP-кандидатом — будет preload в <head>. */
  preloadImage?: string
  /** Canonical URL for SEO + og:url (auto: Astro.url.pathname). */
  canonical?: string
  /** Open Graph image URL (1200×630 recommended). Defaults to /og.png */
  ogImage?: string
  /** Дополнительный JSON-LD schema (Article, Product, etc.) — на специфичных страницах */
  jsonLd?: Record<string, unknown>
}

const {
  title,
  description,
  hideContactStrip = false,
  preloadImage,
  canonical,
  ogImage = '/og.png',
  jsonLd,
} = Astro.props

const lang = (Astro.currentLocale ?? 'ru') as 'ru' | 'en' | 'de'
// Страницы задают свои SEO-строки; фолбэк — локализованный дефолт главной.
const pageTitle = title ?? t(lang, 'seo.home.title')
const pageDescription = description ?? t(lang, 'seo.home.description')

const siteUrl = 'https://kruger-oil.com'
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`

// hreflang: путь без локаль-префикса → ссылки на все три версии страницы
const pathNoLocale = Astro.url.pathname.replace(/^\/(en|de)(?=\/|$)/, '') || '/'
const alternates = [
  { hreflang: 'ru', href: `${siteUrl}${pathNoLocale}` },
  { hreflang: 'en', href: `${siteUrl}/en${pathNoLocale}` },
  { hreflang: 'de', href: `${siteUrl}/de${pathNoLocale}` },
  { hreflang: 'x-default', href: `${siteUrl}${pathNoLocale}` },
]

// Skeleton loading mode — активируется через ?skeleton=1 в URL.
// Превращает текущую страницу в shimmer-плейсхолдер БЕЗ изменения layout/structure.
const isSkeleton = Astro.url.searchParams.get('skeleton') === '1'

// Organization schema — рендерится на всех страницах
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Krüger Motor Oil GmbH',
  alternateName: 'Krüger',
  url: siteUrl,
  logo: `${siteUrl}/logo.svg`,
  description,
  foundingDate: '2017',
  foundingLocation: { '@type': 'Place', name: 'Stuttgart, Germany' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Leitzstraße 45',
    postalCode: '70469',
    addressLocality: 'Stuttgart',
    addressCountry: 'DE',
  },
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: '+49-711-12-34-56-78',
    email: 'info@kruger-oil.de',
    contactType: 'customer support',
    availableLanguage: ['Russian', 'English', 'German'],
  }],
  sameAs: [],
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E51E25" />

    <!-- Автовыбор языка: DE-браузер → /de/, RU/CIS → RU (корень), остальные → /en/.
         Явный выбор из переключателя (localStorage kruger-lang) всегда приоритетнее.
         Авторедирект — один раз за сессию; боты и вебдрайверы не редиректятся (SEO). -->
    <script is:inline>
      (function () {
        try {
          var path = window.location.pathname;
          if (/^\/(en|de)(\/|$)/.test(path)) return;
          if (navigator.webdriver || /bot|crawl|spider|lighthouse|preview/i.test(navigator.userAgent)) return;
          var target = null;
          var saved = localStorage.getItem('kruger-lang');
          if (saved) {
            if (saved === 'en' || saved === 'de') target = saved;
          } else {
            if (sessionStorage.getItem('kruger-lang-auto')) return;
            sessionStorage.setItem('kruger-lang-auto', '1');
            var map = { de: 'de', ru: 'ru', uz: 'ru', kk: 'ru', ky: 'ru', be: 'ru', uk: 'ru', tg: 'ru' };
            var prefs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || 'en'];
            var pick = 'en';
            for (var i = 0; i < prefs.length; i++) {
              var c = String(prefs[i]).slice(0, 2).toLowerCase();
              if (map[c]) { pick = map[c]; break; }
              if (c === 'en') break;
            }
            if (pick !== 'ru') target = pick;
          }
          if (target) {
            window.location.replace('/' + target + path + window.location.search + window.location.hash);
          }
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Krüger Motor Oil" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Organization schema (every page) -->
    <script type="application/ld+json" set:html={safeJsonLd(organizationSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />}

    <!-- Skeleton mode boot (client-side): ?skeleton=1 → data-skeleton="true" БЕЗ FOUC -->
    <script is:inline>
      (function () {
        try {
          var p = new URLSearchParams(window.location.search);
          if (p.get('skeleton') === '1') {
            document.documentElement.setAttribute('data-skeleton-html', 'true');
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html[data-skeleton-html="true"] body { visibility: hidden; }
    </style>

    <ClientRouter />
  </head>
  <body class="bg-bg text-text" data-skeleton={isSkeleton ? 'true' : undefined}>
    <a href="#main" class="skip-link">{t(lang, 'a11y.skipLink')}</a>
    <script is:inline>
      // Sync ?skeleton=1 → body[data-skeleton="true"]. Покрывает SSG-сборку
      // и переходы Astro View Transitions (astro:after-swap).
      (function () {
        function sync() {
          try {
            var p = new URLSearchParams(window.location.search);
            if (p.get('skeleton') === '1') {
              document.body.setAttribute('data-skeleton', 'true');
            } else {
              document.body.removeAttribute('data-skeleton');
            }
            document.documentElement.removeAttribute('data-skeleton-html');
          } catch (e) {}
        }
        sync();
        document.addEventListener('astro:after-swap', sync);
      })();
    </script>
    <TopBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    {!hideContactStrip && <ContactStrip />}
    <Footer />
    <FloatingButtons client:idle />
    <Toast client:idle />

    <script>
      // Motion One reveal + count-up + Lenis smooth scroll.
      // Перезапуск после Astro View Transitions (astro:page-load).
      import { revealOnScroll, bindCountUps } from '@/lib/motion'
      import { initLenis } from '@/lib/lenis'
      const init = () => {
        revealOnScroll()
        bindCountUps()
        initLenis()
      }
      document.addEventListener('astro:page-load', init)
    </script>
  </body>
</html>
