---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/sections/PageHero.astro'
import Card from '@/components/ui/Card.astro'
import Icon from '@/components/ui/Icon.astro'
import ContactFormFull from '@/components/sections/ContactFormFull.vue'
import { t, tRaw, localePath } from '@/lib/i18n'

const lang = (Astro.currentLocale ?? 'ru') as 'ru' | 'en' | 'de'

// Только региональные офисы. HQ (Stuttgart) — отдельной премиум-карточкой слева.
const offices = [
  { code: 'UZ', region: t(lang, 'contactPage.officeUz.region'), name: 'EXTRA STANDART', city: t(lang, 'contactPage.officeUz.city'), phone: '+998 90 880 00 01', email: 'extrastandartoil@gmail.com' },
]

const formLabels = {
  name: t(lang, 'questionForm.nameLabel'),
  namePh: t(lang, 'questionForm.namePh'),
  phone: t(lang, 'questionForm.phoneLabel'),
  phonePh: t(lang, 'questionForm.phonePh'),
  email: t(lang, 'questionForm.emailLabel'),
  emailPh: t(lang, 'questionForm.emailPh'),
  message: t(lang, 'questionForm.messageLabel'),
  messagePh: t(lang, 'questionForm.messagePh'),
  consent: t(lang, 'questionForm.consent'),
  submit: t(lang, 'questionForm.submit'),
  sending: t(lang, 'questionForm.sending'),
  successToast: t(lang, 'questionForm.successToast'),
  errorToast: t(lang, 'questionForm.errorToast'),
}
const formErrors = {
  name: t(lang, 'questionForm.errors.name'),
  emailRequired: t(lang, 'questionForm.errors.emailRequired'),
  emailInvalid: t(lang, 'questionForm.errors.emailInvalid'),
  message: t(lang, 'questionForm.errors.message'),
  consent: t(lang, 'questionForm.errors.consent'),
}
---
<BaseLayout
  title={t(lang, "seo.contact.title")}
  description={t(lang, "seo.contact.description")}
  hideContactStrip
>
  <PageHero
    eyebrow={t(lang, 'contactPage.eyebrow')}
    title={t(lang, 'contactPage.title')}
    lead={t(lang, 'contactPage.lead')}
    breadcrumbs={[{ label: t(lang, 'common.breadcrumbHome'), href: localePath(lang, '/') }, { label: t(lang, 'nav.contact') }]}
  />

  {/* Блок «HQ Germany» + «Regional offices» + «Social media» временно скрыт —
      плейсхолдер-контакты (немецкий телефон, соцсети без ссылок и т.д.) уберём,
      как только появятся финальные данные. */}

  <!-- Form section -->
  <section class="bg-bg-soft py-16 md:py-24 relative overflow-hidden">
    <span
      class="absolute -right-32 -top-32 w-72 h-[42rem] rotate-[18deg] bg-brand-yellow/[0.04] pointer-events-none"
      aria-hidden="true"
    />
    <div class="relative container-page max-w-3xl">
      <div class="text-center mb-10 md:mb-12">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="inline-block h-0.5 w-8 bg-primary" aria-hidden="true" />
          <p class="text-eyebrow md:text-xs font-bold tracking-[0.22em] text-primary uppercase">{t(lang, 'contactPage.writeEyebrow')}</p>
          <span class="inline-block h-0.5 w-8 bg-primary" aria-hidden="true" />
        </div>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">{t(lang, 'contactPage.writeTitle')}</h2>
      </div>

      <ContactFormFull
        client:visible
        topics={tRaw<any[]>(lang, 'contactPage.topics')}
        topicLabel={t(lang, 'contactPage.fields.topic')}
        topicPh={t(lang, 'contactPage.fields.topicPlaceholder')}
        companyLabel={t(lang, 'contactPage.fields.company')}
        companyPh={t(lang, 'contactPage.fields.companyPh')}
        labels={formLabels}
        errors={formErrors}
      />
    </div>
  </section>
</BaseLayout>
