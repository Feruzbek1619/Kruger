---
/**
 * /about/ — fallback redirect stub.
 *
 * В проде Cloudflare Pages применяет 301 из public/_redirects, и эта страница
 * не отдаётся клиенту вовсе. Этот HTML — только страховка для локального preview
 * и адаптеров без поддержки _redirects. delay=0 в meta-refresh — WCAG-compliant
 * (Timing Adjustable не нарушается при немедленном редиректе).
 */
import { t, localePath } from '@/lib/i18n'

const lang = (Astro.currentLocale ?? 'ru') as 'ru' | 'en' | 'de'
const target = localePath(lang, '/about/glance/')
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{t(lang, 'redirect.title')}</title>
    <link rel="canonical" href={`https://kruger-oil.com${target}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a href={target}>{t(lang, 'redirect.link')}</a>
  </body>
</html>
