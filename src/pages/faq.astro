---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/sections/PageHero.astro'
import Accordion from '@/components/ui/Accordion.vue'
import faqFull from '@/mocks/faq-full.json'
import { getFAQ } from '@/lib/api'
import { t, localePath } from '@/lib/i18n'
import { safeJsonLd } from '@/lib/jsonld'

const lang = (Astro.currentLocale ?? 'ru') as 'ru' | 'en' | 'de'

// FAQ из API (сгруппирован по категориям, редактируется в админке).
// Fallback (бэк недоступен) — faq-full.json + i18n-заголовки категорий.
type FaqItem = { id: string; question: string; answer: string }
type FaqSrc = { id?: string | number; question: string; answer: string }
const norm = (arr: FaqSrc[]): FaqItem[] =>
  arr.map((it) => ({ id: String(it.id ?? it.question), question: it.question, answer: it.answer }))

const apiGroups = await getFAQ(lang)
const sections: { key: string; label: string; items: FaqItem[] }[] = apiGroups.length
  ? apiGroups.map((g) => ({ key: String(g.id ?? g.title), label: g.title, items: norm(g.items) }))
  : [
      { key: 'products', label: t(lang, 'faq.categories.products'), items: norm(faqFull.products) },
      { key: 'quality',  label: t(lang, 'faq.categories.quality'),  items: norm(faqFull.quality) },
      { key: 'buying',   label: t(lang, 'faq.categories.buying'),   items: norm(faqFull.buying) },
      { key: 'service',  label: t(lang, 'faq.categories.service'),  items: norm(faqFull.service) },
    ]

// FAQPage schema.org
const allItems = sections.flatMap((s) => s.items)
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
}
---
<BaseLayout
  title={t(lang, "seo.faq.title")}
  description={t(lang, "seo.faq.description")}
>
  <PageHero
    title={t(lang, 'faqPage.title')}
    lead={t(lang, 'faqPage.lead')}
    breadcrumbs={[{ label: t(lang, 'common.breadcrumbHome'), href: localePath(lang, '/') }, { label: t(lang, 'nav.faq') }]}
  />
  <section class="bg-bg py-16 md:py-24">
    <div class="container-page max-w-3xl">
      {sections.map((s) => (
        <div class="mb-10">
          <h2 class="font-display text-xl md:text-2xl font-bold mb-4">{s.label}</h2>
          <Accordion client:visible items={s.items} />
        </div>
      ))}
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={safeJsonLd(schema)} />
</BaseLayout>
