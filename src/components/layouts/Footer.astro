---
import { t, localePath } from '@/lib/i18n'
import Logo from '@/components/ui/Logo.astro'
import Icon from '@/components/ui/Icon.astro'
const lang = (Astro.currentLocale ?? 'ru') as 'ru' | 'en' | 'de'
---
<footer class="relative bg-bg-dark text-text-inverse overflow-hidden">
  <!-- Diagonal accent в углу -->
  <div
    class="absolute -left-24 -bottom-32 w-72 h-[42rem] -rotate-[18deg] bg-brand-yellow/[0.04] pointer-events-none"
    aria-hidden="true"
  />

  <div class="relative container-page py-16 md:py-20 grid gap-10 md:grid-cols-12">
    <!-- Brand column -->
    <div class="md:col-span-4">
      <Logo variant="white" class="h-14 md:h-20 w-auto" />
      <p class="mt-7 text-sm leading-relaxed opacity-75 max-w-xs">
        {t(lang, 'footer.brandDescription')}
      </p>
      {/* Соцсети временно скрыты — иконки без реальных ссылок. Вернём, когда появятся аккаунты. */}
    </div>

    <!-- Main links -->
    <div class="md:col-span-2">
      <h3 class="font-display font-bold text-xs uppercase tracking-[0.18em] mb-5 text-brand-yellow">
        {t(lang, 'footer.colMain')}
      </h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href={localePath(lang, "/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.home')}</a></li>
        <li><a href={localePath(lang, "/products/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.catalog')}</a></li>
        <li><a href={localePath(lang, "/about/glance/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.about')}</a></li>
        <li><a href={localePath(lang, "/services/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.services')}</a></li>
        <li><a href={localePath(lang, "/news/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.news')}</a></li>
        <li><a href={localePath(lang, "/faq/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.faq')}</a></li>
        <li><a href={localePath(lang, "/contact/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'nav.contact')}</a></li>
      </ul>
    </div>

    <!-- Products -->
    <div class="md:col-span-3">
      <h3 class="font-display font-bold text-xs uppercase tracking-[0.18em] mb-5 text-brand-yellow">
        {t(lang, 'footer.colProducts')}
      </h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href={localePath(lang, "/products/?category=engine")}     class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.engine')}</a></li>
        <li><a href={localePath(lang, "/products/?category=hydraulic")}  class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.hydraulic')}</a></li>
        <li><a href={localePath(lang, "/products/?category=manual")}     class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.transmission')}</a></li>
        <li><a href={localePath(lang, "/products/?category=antifreeze")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.antifreeze')}</a></li>
        <li><a href={localePath(lang, "/products/?category=ev-fluids")}  class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.ev')}</a></li>
        <li><a href={localePath(lang, "/products/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.all')}</a></li>
        <li><a href={localePath(lang, "/pds-sds/")} class="opacity-75 hover:opacity-100 hover:text-brand-yellow transition-colors">{t(lang, 'footer.products.pds')}</a></li>
      </ul>
    </div>

    <!-- Subscribe -->
    <div class="md:col-span-3">
      <h3 class="font-display font-bold text-xs uppercase tracking-[0.18em] mb-5 text-brand-yellow">
        Newsletter
      </h3>
      <p class="text-sm opacity-75 mb-5 leading-relaxed">{t(lang, 'footer.subscribeText')}</p>
      <form
        id="kr-newsletter"
        class="space-y-2.5"
        data-msg-invalid={t(lang, 'questionForm.errors.emailInvalid')}
        data-msg-success={t(lang, 'footer.subscribeSuccess')}
        data-msg-error={t(lang, 'footer.subscribeError')}
      >
        <!-- Honeypot — скрыто от людей, приманка для ботов (не удалять) -->
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="sr-only"
        />
        <input
          type="email"
          name="email"
          required
          aria-label={t(lang, 'footer.subscribePlaceholder')}
          placeholder={t(lang, 'footer.subscribePlaceholder')}
          class="w-full h-12 rounded-md bg-text-inverse/[0.05] border border-text-inverse/15 px-4 text-sm text-text-inverse placeholder:text-text-inverse/40 focus:outline-none focus:border-brand-yellow transition-colors"
        />
        <button
          type="submit"
          data-loading-label={t(lang, 'questionForm.sending')}
          data-default-label={t(lang, 'footer.subscribeBtn')}
          class="kr-newsletter-btn w-full inline-flex items-center justify-center h-12 px-5 rounded-md bg-primary hover:bg-primary-hover text-text-inverse text-sm font-semibold transition-colors disabled:opacity-60"
        >
          {t(lang, 'footer.subscribeBtn')}
        </button>
        <p class="kr-newsletter-msg hidden text-xs leading-snug" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="relative border-t border-text-inverse/10">
    <div class="container-page py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
      <span class="opacity-60">{t(lang, 'footer.rights')}</span>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 opacity-60">
        <li><a href={localePath(lang, "/impressum/")} class="hover:text-brand-yellow hover:opacity-100">{t(lang, 'footer.legal.impressum')}</a></li>
        <li><a href={localePath(lang, "/privacy/")}   class="hover:text-brand-yellow hover:opacity-100">{t(lang, 'footer.legal.privacy')}</a></li>
        <li><a href={localePath(lang, "/terms/")}     class="hover:text-brand-yellow hover:opacity-100">{t(lang, 'footer.legal.terms')}</a></li>
        <li><a href={localePath(lang, "/cookies/")}   class="hover:text-brand-yellow hover:opacity-100">{t(lang, 'footer.legal.cookies')}</a></li>
      </ul>
      <span class="opacity-60">
        {t(lang, 'footer.designedBy')} <strong class="text-brand-yellow font-bold ml-1">DASTA</strong>
      </span>
    </div>
  </div>
</footer>

<script>
  // Newsletter form: POST через единый submitInquiry({ kind: 'newsletter' }).
  // В mock-mode (PUBLIC_USE_MOCKS=true) симулирует 700ms задержку и возвращает фейковый id.
  import { submitInquiry } from '@/lib/api'

  const init = () => {
    const form = document.getElementById('kr-newsletter') as HTMLFormElement | null
    if (!form) return
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
    const msg = form.querySelector<HTMLParagraphElement>('.kr-newsletter-msg')!
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]')!
    const defaultLabel = btn.dataset.defaultLabel || 'Подписаться'
    const loadingLabel = btn.dataset.loadingLabel || 'Отправляем…'

    const setMsg = (text: string, kind: 'success' | 'error') => {
      msg.textContent = text
      msg.classList.remove('hidden', 'text-success', 'text-error')
      msg.classList.add(kind === 'success' ? 'text-success' : 'text-error')
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (honeypot.value) return // honeypot: поле скрыто от людей — если заполнено, это бот
      const email = input.value.trim()
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setMsg(form.dataset.msgInvalid ?? '', 'error')
        input.focus()
        return
      }
      btn.disabled = true
      btn.textContent = loadingLabel
      try {
        await submitInquiry({ kind: 'newsletter', email, consent: true })
        setMsg(form.dataset.msgSuccess ?? '', 'success')
        input.value = ''
      } catch {
        setMsg(form.dataset.msgError ?? '', 'error')
      } finally {
        btn.disabled = false
        btn.textContent = defaultLabel
      }
    })
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true })
  } else {
    init()
  }
</script>
